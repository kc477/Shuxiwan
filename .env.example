DATABASE_URL="file:./dev.db"

# AI provider — leave unset for offline stub (default if no key).
# Set to "anthropic" to force-enable real Claude (or just provide a credential below).
AI_PROVIDER=""

# Provide ONE of these. The Anthropic SDK accepts either.
# - ANTHROPIC_AUTH_TOKEN ships as `Authorization: Bearer ...` (OAuth-style).
# - ANTHROPIC_API_KEY ships as `x-api-key`.
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_API_KEY=""
